{
  "schemaVersion": 1,
  "id": "pi.model-usage-dashboard",
  "name": "Model Usage Dashboard",
  "version": "0.1.0",
  "description": "A private, local-first dashboard for PI-Desktop model requests, tokens, trends, and clearly labelled API-equivalent estimates.",
  "author": "PI-Desktop community",
  "icon": "assets/icon.png",
  "main": "main.js",
  "ui": {
    "panel": "renderer/index.html",
    "width": 1120,
    "height": 800,
    "resizable": true,
    "title": {
      "en": "Model Usage Dashboard",
      "zh-CN": "模型用量仪表盘"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "modelUsageDashboard.open",
        "title": "Model Usage Dashboard: Open",
        "keywords": [
          "model usage",
          "usage",
          "tokens",
          "cost",
          "quota",
          "stats",
          "模型用量",
          "用量",
          "统计",
          "费用",
          "额度"
        ],
        "category": "Productivity"
      }
    ]
  },
  "permissions": [
    "ui.panel",
    "models.list"
  ],
  "engines": {
    "piDesktop": ">=0.2.0"
  },
  "activationEvents": [
    "onCommand:modelUsageDashboard.open",
    "onStartup"
  ]
}
